# Normalise all text to LF in the repository, whatever the checkout platform does.
* text=auto eol=lf

*.py    text eol=lf diff=python
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.sh    text eol=lf
*.sql   text eol=lf
Makefile text eol=lf
*.gradle text eol=lf
*.bat   text eol=crlf

# Binary — never diff, never normalise
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.apk   binary
*.aab   binary
*.keystore binary

# Golden fixtures pin pipeline output — a diff must be reviewed, never auto-merged.
backend/tests/fixtures/**/*.json -merge linguist-generated=false
