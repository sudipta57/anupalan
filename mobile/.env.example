# Anupalan mobile — environment.
#
# Copy to `.env`. Expo only exposes variables prefixed `EXPO_PUBLIC_` to the app, and it inlines
# them at build time — so changing either of these needs a rebuild (or a Metro restart in dev),
# not just an app relaunch.
#
# Anything here is readable in the shipped bundle. Never put a secret in this file.

# Where data comes from.
#
#   mock  (default)  fixtures from src/api/mock — 220 seeded scans, the hero inspection, the
#                    Sahayak corpus, the sample PDF and DOCX. No backend needed.
#   live             HTTP against EXPO_PUBLIC_API_URL.
#
# `live` also removes the fixture layer from the bundle: metro.config.js resolves everything under
# src/api/mock to an empty module, so the release build carries no offline fake of the tool.
# Verify with `npm run verify:bundle`.
EXPO_PUBLIC_API_MODE=mock

# API origin, without the /v1 prefix — src/api/config.ts adds it.
#
# `localhost` does not work from a physical Android device: the phone resolves it to itself. Use the
# development machine's LAN address (`ip addr` / `ifconfig`) and make sure both are on the same
# network, or run `adb reverse tcp:8000 tcp:8000` over USB.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Used by `npm run gen:api` only, to fetch the OpenAPI schema at build time. Not read by the app,
# so it carries no EXPO_PUBLIC_ prefix.
ANUPALAN_API_URL=http://localhost:8000
