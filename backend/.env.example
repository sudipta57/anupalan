# Anupalan backend — example configuration.
#
# Copy to .env and paste your real values:  cp .env.example .env
# .env is gitignored and must stay that way.
#
# NO REAL CREDENTIALS IN THIS FILE. Every value below is a documented default or a placeholder
# in angle brackets. Never paste a connection string, token or key here — this file is committed
# (CONTRIBUTING.md §7). Provisioning steps for each service are in infra/README.md.
#
# There is no local infrastructure and nothing to start: Postgres, Redis and object storage are
# managed services. Without these values, GET /health answers 200 with status "degraded".

# ---------------------------------------------------------------- app
APP_NAME=anupalan
ENV=local                       # local | ci | staging | production
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/v1

# JSON array. 8081 is the Expo dev server; add your LAN origin for a device on Wi-Fi.
CORS_ORIGINS=["http://localhost:8081"]

# ---------------------------------------------------------------- database (Neon)
# Two connection strings, both from the Neon dashboard. See infra/README.md §1 for why.
#
#   DATABASE_URL         the POOLED endpoint   (host contains "-pooler")   -> API and worker
#   DATABASE_URL_DIRECT  the DIRECT endpoint   (no "-pooler")              -> Alembic only
#
# Keep the postgresql+psycopg:// scheme so SQLAlchemy selects psycopg 3, and keep
# ?sslmode=require — Neon refuses plaintext connections.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL_DIRECT=postgresql+psycopg://<user>:<password>@<project>.<region>.aws.neon.tech/<db>?sslmode=require

# Recycle below Neon's idle timeout so a suspended branch never returns a dead connection.
DB_POOL_RECYCLE=280
# Seconds. Covers a cold start after Neon scales to zero.
DB_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------- redis (Redis Cloud)
# Use the rediss:// scheme. It is what switches Celery's TLS on (app/worker.py); a redis:// URL
# against a TLS endpoint fails at connect time. Redis Cloud uses a non-default port.
REDIS_URL=rediss://default:<password>@<host>.redis-cloud.com:<port>/0

# Celery reuses REDIS_URL when these are unset. Set them only to split broker from backend.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# ---------------------------------------------------------------- object storage (Cloudflare R2)
# R2 speaks the S3 API, which is why these are named S3_*: any S3-compatible store (MinIO
# on-premise, AWS S3) works by changing the endpoint and the keys.
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2 has no regions and requires the literal string "auto".
S3_REGION=auto
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=<r2-access-key-id>
S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
S3_USE_PATH_STYLE=true
S3_PRESIGN_EXPIRY_SECONDS=900
# Optional custom domain for public reads. Buckets stay private; access is by presigned URL.
# S3_PUBLIC_BASE_URL=https://assets.example.in

# ---------------------------------------------------------------- metrology
# Pixels per millimetre in the rectified plane (docs/01-architecture.md §5 S3).
# Imported from app.config everywhere. Never written at a call site (CLAUDE.md §8).
PX_PER_MM=20

# ---------------------------------------------------------------- rule packs
# Data, versioned independently of code, outside backend/ (CLAUDE.md §2).
# Defaults are resolved relative to the repo root; set these to override.
# RULEPACK_PATH=../rulepacks/lm-2011-v1.yaml
# RULEPACK_DIR=../rulepacks
